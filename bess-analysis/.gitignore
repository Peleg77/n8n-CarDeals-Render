.venv/
__pycache__/
*.pyc
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep
outputs/charts/*
!outputs/charts/.gitkeep
outputs/*.xlsx

# demo/ (synthetic-data run) keeps its report, charts and workbook committed
# as proof the pipeline works, but not the intermediate parquet.
demo/data_clean/*.parquet
